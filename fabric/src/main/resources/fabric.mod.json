{
    "schemaVersion": 1,
    "id": "${modId}",
    "version": "${modVersion}+mc${stonecutterVersion}",
    "name": "${modName}",
    "description": "${modDescription}",
    "license": "${modLicense}",
    "authors": [
        "${modAuthors}"
    ],
    "contributors": [],
    "contact": {
        "homepage": "${modWebsite}",
        "sources": "${modSource}",
        "issues": "${modIssues}"
    },
    "environment": "client",
    "icon": "icon.png",
    "entrypoints": {
        "modmenu": [
            "sh.kaban.craftgr.fabric.ModMenuIntegration"
        ],
        "client": [
            "sh.kaban.craftgr.fabric.CraftGRFabric"
        ],
        "server": []
    },
    "mixins": [
        "craftgr-common.mixins.json"
    ],
    "depends": {
        "minecraft": ">=${minecraftVersion}",
        "fabricloader": ">=${fabricLoaderVersion}",
        "fabric-api": ">=${fabricApiVersion}"
    },
    "recommends": {
        "yet_another_config_lib_v3": ">=${yaclVersion}-"
    },
    "suggests": {
        "modmenu": ">=${modMenuVersion}-"
    },
    "custom": {
        "modmenu:clientsideOnly": true
    }
}
